android_app {
    name: "HighBrightnessMode",

    defaults: ["SettingsLibDefaults"],
    
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    
    static_libs: [
        "androidx.core_core-ktx",
    ],
    
    optimize: {
        enabled: false,
        proguard_flags_files: ["proguard.flags"],
    },
    
    dex_preopt: {
        enabled: false,
    },
    
    required: [
        "privapp_whitelist_com.android.hbm",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.hbm",
    sub_dir: "permissions",
    src: "privapp_whitelist_com.android.hbm.xml",
    filename_from_src: true,
    system_ext_specific: true,
}
