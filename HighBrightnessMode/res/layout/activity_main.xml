<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hbm_mode_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="48dp" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radio_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbm_mode_auto"
                android:textSize="16sp"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <RadioButton
                android:id="@+id/radio_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hbm_mode_manual"
                android:textSize="16sp"
                android:minHeight="48dp"
                android:paddingVertical="12dp"
                android:checked="true" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hbm_description"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</ScrollView>
